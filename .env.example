# ── Supabase ──────────────────────────────────────────────────────────────────
# URL de ton projet Supabase (Settings → API → Project URL)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique anon (Settings → API → anon public)
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service (Settings → API → service_role) — utilisée UNIQUEMENT côté serveur (webhook)
# Ne jamais exposer dans le frontend !
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Clé secrète Stripe (Dashboard → Developers → API keys → Secret key)
STRIPE_SECRET_KEY=sk_live_...

# ID du prix de l'abonnement Pro 39€/mois (Dashboard → Products → ton produit → Price ID)
STRIPE_PRICE_ID=price_...

# Secret du webhook Stripe (Dashboard → Webhooks → ton endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────────────────────
# URL publique de l'application (sans slash final)
VITE_APP_URL=https://fonte-coaching.vercel.app
